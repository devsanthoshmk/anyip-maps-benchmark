# ── AnyIP API ─────────────────────────────────────────────────────────────────
# REST API key — find it at https://dashboard.anyip.io/account/
ANYIP_API_KEY=your_api_key_here

# Your team ID (run: curl -H "api-key: KEY" https://dashboard.anyip.io/api/users/me)
ANYIP_TEAM_ID=your_team_id_here

# ── Proxy credentials ─────────────────────────────────────────────────────────
# Proxy user username (short ID, without "user_" prefix)
# Found at: dashboard → Proxies → Proxy users tab
ANYIP_PROXY_USER=your_proxy_username
ANYIP_PROXY_PASS=your_proxy_password

# AnyIP gateway — do NOT change these unless AnyIP tells you to
ANYIP_HOST=portal.anyip.io
ANYIP_PORT=1080

# ── Session config ────────────────────────────────────────────────────────────
# Sticky session duration in minutes (AnyIP recommends 15-30 for Google Maps)
SESSION_DURATION_MIN=20

# Session strategy: per-query | per-country | shared | resume-last
# (bench.py asks interactively; this is only the default when not a TTY or --no-ask)
SESSION_STRATEGY=per-query

# Proxy type: residential | mobile
# Switch to mobile if India shows consent rate > 5% on residential
PROXY_TYPE=residential

# Geo targets (comma-separated ISO-3166-1 alpha-2 codes)
GEO_TARGETS=IN,US
